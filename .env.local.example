# ==============================================================================
# GODT Regional 3 — Variables de entorno para Compose local
# Copiar como .env.local y ajustar valores reales antes de levantar el stack:
#   cp .env.local.example .env.local
# NUNCA commitear .env.local al repositorio.
# ==============================================================================

# Modo de ejecución de pruebas locales ('production' por defecto para paridad ACA;
# usar 'development' si se prueba login/cookies con curl sobre HTTP sin HTTPS)
APP_NODE_ENV=production

# Base de datos PostgreSQL (privada dentro de godt-network)
POSTGRES_DB=godt
POSTGRES_USER=godt
POSTGRES_PASSWORD=replace_with_strong_local_postgres_password
DATABASE_URL=postgresql://godt:replace_with_strong_local_postgres_password@postgres:5432/godt?schema=public

# Colas BullMQ respaldadas por PostgreSQL (elimina dependencia de Redis)
BULLMQ_BACKEND=postgres
BULLMQ_PG_SCHEMA=bullmq

# Autenticación JWT y cookies HttpOnly (OBLIGATORIO: >= 32 caracteres aleatorios)
JWT_SECRET=generate_64_random_hex_chars_for_local_compose_testing_only
JWT_ISSUER=godt-backend
JWT_AUDIENCE=godt-frontend
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_COOKIE_NAME=godt_refresh_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=strict
TRUST_PROXY=true
CORS_ORIGIN=http://localhost:8080
SWAGGER_ENABLED=false

# Almacenamiento privado (en local usa volumen compartido godt-storage; en Azure usar 'azure')
STORAGE_PROVIDER=local
DOCUMENT_STORAGE_MAX_BYTES=20971520
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=godt-documents

# Workers OCR y Dossier
OCR_PROVIDER=tesseract
OCR_CONCURRENCY=1
DOSSIER_CONCURRENCY=2
AI_EXTERNAL_PROVIDER_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Puerto único publicado por Nginx gateway
GATEWAY_PORT=8080

