# ==============================================================================
# GODT REGIONAL 3 — CONFIGURACIÓN DE VARIABLES DE ENTORNO (BACKEND)
# ==============================================================================
# IMPORTANTE: Copie este archivo a .env y configure los valores según el entorno.
# NUNCA guarde contraseñas reales ni secretos criptográficos en el repositorio.

# ------------------------------------------------------------------------------
# 1. ENTORNO Y SERVIDOR
# ------------------------------------------------------------------------------
# Valores permitidos: 'development', 'test', 'staging', 'production'.
NODE_ENV=development
PORT=3000
APP_NAME=godt-backend

# Identificador de instancia/pod para entornos multi-worker (opcional).
# El sistema adjunta un sufijo determinista unívoco pid-token para evitar colisiones.
INSTANCE_ID=godt-backend-worker-1

# Habilitación de documentación Swagger (deshabilitado por defecto en production).
SWAGGER_ENABLED=true

# ------------------------------------------------------------------------------
# 2. BASE DE DATOS (POSTGRESQL 16+)
# ------------------------------------------------------------------------------
# Cadena de conexión obligatoria. En producción requiere TLS (sslmode=require).
DATABASE_URL=postgresql://godt:change_this_local_password@localhost:5432/godt?schema=public

# ------------------------------------------------------------------------------
# 3. COLAS PERSISTENTES Y CACHÉ (REDIS 7+ / BULLMQ)
# ------------------------------------------------------------------------------
# URL de conexión a Redis (obligatorio en staging y production).
REDIS_URL=redis://localhost:6379

# Fallback en memoria: permitido ÚNICAMENTE en development/test para pruebas locales.
# En 'staging' y 'production' este valor es estrictamente IGNORADO por seguridad.
ENABLE_IN_MEMORY_QUEUE_FALLBACK=false

# ------------------------------------------------------------------------------
# 4. SEGURIDAD, SESIONES Y AUTENTICACIÓN JWT
# ------------------------------------------------------------------------------
# Secreto para firma de tokens JWT. OBLIGATORIO en cualquier entorno: Mínimo 32 caracteres.
# En producción/staging el arranque fallará si se detecta un secreto débil o por defecto.
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters_randomly_generated
JWT_ISSUER=godt-backend
JWT_AUDIENCE=godt-frontend
JWT_ACCESS_EXPIRES_IN=15m

# Sesiones y refresh token en cookie HttpOnly
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_COOKIE_NAME=godt_refresh_token
# En producción/staging AUTH_COOKIE_SECURE se fuerza siempre a true por seguridad aunque aquí sea false.
# En local HTTP de desarrollo puede dejarse en false.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=strict

# Rate limiting en login y refresh
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_IP_MAX=30
AUTH_RATE_LIMIT_WINDOW_MS=60000
TRUST_PROXY=false

# ------------------------------------------------------------------------------
# 5. POLÍTICA DE ORÍGENES CRUZADOS (CORS)
# ------------------------------------------------------------------------------
# Lista separada por comas de orígenes frontend autorizados.
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 6. ALMACENAMIENTO PRIVADO DE DOCUMENTOS Y EXPEDIENTES
# ------------------------------------------------------------------------------
# Proveedor de almacenamiento: 'local' (desarrollo/servidor) o 's3'/'r2' (nube).
STORAGE_PROVIDER=local

# Ruta absoluta o relativa al directorio privado del sistema (fuera de webroot).
LOCAL_STORAGE_PATH=storage/private

# Límite máximo de tamaño por archivo subido (en bytes). 10 MB por defecto.
DOCUMENT_STORAGE_MAX_BYTES=10485760

# Configuración S3 / Cloudflare R2 (requerido si STORAGE_PROVIDER=s3 o r2).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# ------------------------------------------------------------------------------
# 7. PROCESAMIENTO OCR Y EXTRACCIÓN DOCUMENTAL (OPCIONAL)
# ------------------------------------------------------------------------------
OCR_PROVIDER=tesseract
OCR_CONCURRENCY=1
OCR_ALLOWED_FIELDS=bloodGroup,rhFactor,clinicalService
TESSERACT_BIN=tesseract
TESSERACT_LANG=eng
TESSERACT_TIMEOUT_MS=30000
PDFINFO_BIN=pdfinfo
PDFTOPPM_BIN=pdftoppm
OCR_PDF_MAX_PAGES=10
OCR_PDF_DPI=150
OCR_PDF_TIMEOUT_MS=30000
OCR_PDF_MAX_RASTER_BYTES=52428800
OCR_FIELD_ALIASES=

# Bandera piloto local para edición en borrador (mantener false en producción).
DOCUMENT_ENGINE_ALLOW_DRAFT_INSTANCES=false

# ------------------------------------------------------------------------------
# 8. INTELIGENCIA ARTIFICIAL Y MODELOS SEMÁNTICOS (OPCIONAL - DESARROLLO LOCAL)
# ------------------------------------------------------------------------------
# Habilitación de IA externa: 'false' por defecto. Permitido ÚNICAMENTE en 'development'.
# En 'staging' y 'production' se desactiva estrictamente por confidencialidad clínica.
AI_EXTERNAL_PROVIDER_ENABLED=false

# Clave de API de Google Gemini (requerida si AI_EXTERNAL_PROVIDER_ENABLED=true).
# NUNCA guarde claves reales en este archivo ni las exponga en el frontend.
GEMINI_API_KEY=

# Modelo Gemini a utilizar. Opciones recomendadas: 'gemini-3.8-flash', 'gemini-3.5-flash'.
GEMINI_MODEL=gemini-3.8-flash
