NODE_ENV=development
PORT=3000
APP_NAME=godt-backend
DATABASE_URL=postgresql://godt:change_this_local_password@localhost:5432/godt?schema=public
REDIS_URL=redis://localhost:6379
SWAGGER_ENABLED=true
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_ISSUER=godt-backend
DOCUMENT_STORAGE_PATH=storage/private
OCR_PROVIDER=tesseract
OCR_CONCURRENCY=1
OCR_ALLOWED_FIELDS=bloodGroup,rhFactor,clinicalService
TESSERACT_BIN=tesseract
TESSERACT_LANG=eng
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
