NODE_ENV=development
PORT=3000
APP_NAME=godt-backend
DATABASE_URL=postgresql://godt:change_this_local_password@localhost:5432/godt?schema=public
REDIS_URL=redis://localhost:6379
SWAGGER_ENABLED=true
# Local-only ADMIN pilot testing; keep false outside development.
DOCUMENT_ENGINE_ALLOW_DRAFT_INSTANCES=false
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_ISSUER=godt-backend
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=storage/private
DOCUMENT_STORAGE_MAX_BYTES=10485760
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
OCR_PROVIDER=tesseract
OCR_CONCURRENCY=1
OCR_ALLOWED_FIELDS=bloodGroup,rhFactor,clinicalService
TESSERACT_BIN=tesseract
TESSERACT_LANG=eng
TESSERACT_TIMEOUT_MS=30000
PDFINFO_BIN=pdfinfo
PDFTOPPM_BIN=pdftoppm
OCR_PDF_MAX_PAGES=10
OCR_PDF_DPI=150
OCR_PDF_TIMEOUT_MS=30000
OCR_PDF_MAX_RASTER_BYTES=52428800
# JSON object mapping canonical fields to institutionally approved OCR labels.
# Example: {"bloodGroup":["Blood group"],"rhFactor":["Rh factor"]}
OCR_FIELD_ALIASES=
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
