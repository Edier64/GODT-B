generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  COORDINATOR
  SURGEON
  TECHNICIAN
  ADMIN

  @@map("user_role")
}

enum DonorRecordStatus {
  EN_VALORACION
  ACTIVO
  CERRADO

  @@map("donor_record_status")
}

enum BrainDeathCertificationStatus {
  BORRADOR
  CERTIFICADA

  @@map("brain_death_certification_status")
}

enum LegalizationMechanism {
  PRESUNCION_LEGAL
  CONSENTIMIENTO_FAMILIAR

  @@map("legalization_mechanism")
}

enum OcrJobStatus {
  EN_COLA
  COMPLETADO
  FALLIDO

  @@map("ocr_job_status")
}

enum OcrValidationStatus {
  PENDIENTE
  CONFIRMADO
  MODIFICADO
  RECHAZADO

  @@map("ocr_validation_status")
}

enum TissueCategory {
  OCULAR
  CARDIOVASCULAR
  OSTEOMUSCULAR
  PIEL

  @@map("tissue_category")
}

enum DonationProcessStatus {
  EN_VALORACION
  EN_CURSO
  COMPLETADO
  CANCELADO
  SUSPENDIDO

  @@map("donation_process_status")
}

enum ProcessInstitutionRole {
  IPS_GENERADORA
  IPS_EXTRACTORA
  BANCO_TEJIDOS
  IPS_TRASPLANTADORA
  INMLCF
  COORDINACION_REGIONAL
  OTRO

  @@map("process_institution_role")
}

enum ProcessParticipantRole {
  COORDINADOR_OPERATIVO
  MEDICO_CERTIFICADOR
  MEDICO_TRATANTE
  CIRUJANO_RESCATE
  TECNICO_TEJIDOS
  DEUDO_NOTIFICADO
  REPRESENTANTE_LEGAL
  TESTIGO
  CUSTODIO
  OTRO

  @@map("process_participant_role")
}

model SystemUser {
  id                    String                    @id @default(uuid()) @db.Uuid
  email                 String                    @unique @db.VarChar(320)
  fullName              String                    @map("full_name") @db.VarChar(200)
  professionalId        String?                   @map("professional_id") @db.VarChar(100)
  role                  UserRole
  isActive              Boolean                   @default(true) @map("is_active")
  createdAt             DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  donorRecordsCreated   DonorRecord[]             @relation("DonorCreatedBy")
  certificationsPrimary BrainDeathCertification[] @relation("PrimaryCertifier")
  certificationsSecond  BrainDeathCertification[] @relation("SecondCertifier")
  legalizations         DonationLegalization[]    @relation("LegalizationOfficer")
  documentsUploaded     SourceDocument[]          @relation("DocumentUploader")
  ocrJobsRequested      OcrProcessingJob[]        @relation("OcrRequester")
  ocrFieldsValidated    OcrExtractedField[]       @relation("OcrValidator")
  surgeriesLed          OrganRecoverySurgery[]    @relation("LeadSurgeonSurgery")
  tissueAsTechnician    TissueRecoveryProcedure[] @relation("TissueTechnician")
  tissueAsSurgeon       TissueRecoveryProcedure[] @relation("TissueSurgeon")
  templateVersionsAuth  TemplateVersion[]         @relation("TemplateAuthorizer")
  templateVersionsCreated TemplateVersion[]       @relation("TemplateVersionCreator")
  generatedDocuments    GeneratedPdfDocument[]    @relation("DocumentGenerator")
  approvedDocuments     GeneratedPdfDocument[]    @relation("DocumentApprover")
  documentInstancesCreated DocumentInstance[]      @relation("DocumentInstanceCreator")
  documentInstancesUpdated DocumentInstance[]      @relation("DocumentInstanceUpdater")
  responseRevisionsCreated DocumentResponseRevision[] @relation("ResponseRevisionCreator")
  provenanceValidated   DocumentFieldProvenance[] @relation("ProvenanceValidator")
  conflictsResolved     DocumentFieldProvenance[] @relation("ConflictResolver")
  auditEvents           AuditEvent[]              @relation("AuditActor")
  processesOpened       DonationProcess[]         @relation("ProcessOpenedBy")
  processesClosed       DonationProcess[]         @relation("ProcessClosedBy")
  processParticipants   ProcessParticipant[]      @relation("ParticipantSystemUser")
  packagesCreated       ProcessPackage[]          @relation("PackageCreator")
  packageVersionsCreated ProcessPackageVersion[]  @relation("PackageVersionCreator")
  packageVersionsAuth   ProcessPackageVersion[]   @relation("PackageVersionAuthorizer")
  canonicalFieldsCreated CanonicalFieldDefinition[] @relation("CanonicalFieldCreator")
  canonicalValuesUpdated ProcessCanonicalValue[]  @relation("CanonicalValueUpdater")
  canonicalHistoryCreated ProcessCanonicalHistory[] @relation("CanonicalHistoryCreator")

  @@map("SYSTEM_USER")
}

model DonorRecord {
  id                      String                    @id @default(uuid()) @db.Uuid
  rndCode                 String                    @unique @map("rnd_code") @db.VarChar(100)
  status                  DonorRecordStatus
  originatingIpsName      String                    @map("originating_ips_name") @db.VarChar(200)
  clinicalService         String                    @map("clinical_service") @db.VarChar(200)
  fullName                String                    @map("full_name") @db.VarChar(200)
  documentNumber          String                    @map("document_number") @db.VarChar(100)
  anthropometry           Json?
  bloodGroup              String?                   @map("blood_group") @db.VarChar(20)
  rhFactor                String?                   @map("rh_factor") @db.VarChar(20)
  clinicalData            Json?                     @map("clinical_data")
  createdById             String                    @map("created_by") @db.Uuid
  createdAt               DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy               SystemUser                @relation("DonorCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  brainDeathCertification BrainDeathCertification?
  donationLegalization    DonationLegalization?
  sourceDocuments         SourceDocument[]
  ocrFields               OcrExtractedField[]
  organSurgeries          OrganRecoverySurgery[]
  tissueProcedures        TissueRecoveryProcedure[]
  generatedDocuments      GeneratedPdfDocument[]
  documentInstances       DocumentInstance[]
  donationProcesses       DonationProcess[]

  @@index([status])
  @@index([documentNumber])
  @@map("DONOR_RECORD")
}

model BrainDeathCertification {
  id                     String                        @id @default(uuid()) @db.Uuid
  donorId                String                        @unique @map("donor_id") @db.Uuid
  certifyingPhysicianId  String                        @map("certifying_physician_id") @db.Uuid
  secondPhysicianId      String                        @map("second_physician_id") @db.Uuid
  evaluationStartedAt    DateTime?                     @map("evaluation_started_at") @db.Timestamptz(6)
  diagnosisConfirmedAt   DateTime?                     @map("diagnosis_confirmed_at") @db.Timestamptz(6)
  apneaTestResult        Json?                         @map("apnea_test_result")
  confirmatoryTestResult Json?                         @map("confirmatory_test_result")
  status                 BrainDeathCertificationStatus
  donor                  DonorRecord                   @relation(fields: [donorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  certifyingPhysician    SystemUser                    @relation("PrimaryCertifier", fields: [certifyingPhysicianId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  secondPhysician        SystemUser                    @relation("SecondCertifier", fields: [secondPhysicianId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([certifyingPhysicianId])
  @@index([secondPhysicianId])
  @@map("BRAIN_DEATH_CERTIFICATION")
}

model DonationLegalization {
  id                   String                   @id @default(uuid()) @db.Uuid
  donorId              String                   @unique @map("donor_id") @db.Uuid
  mechanism            LegalizationMechanism
  officerInChargeId    String                   @map("officer_in_charge_id") @db.Uuid
  rndCheckReference    String?                  @map("rnd_check_reference") @db.VarChar(200)
  familyNotificationAt DateTime?                @map("family_notification_at") @db.Timestamptz(6)
  status               String                   @db.VarChar(50)
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  donor                DonorRecord              @relation(fields: [donorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  officerInCharge      SystemUser               @relation("LegalizationOfficer", fields: [officerInChargeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  representatives      DonationRepresentative[]

  @@index([officerInChargeId])
  @@map("DONATION_LEGALIZATION")
}

model DonationRepresentative {
  id                  String               @id @default(uuid()) @db.Uuid
  legalizationId      String               @map("legalization_id") @db.Uuid
  fullName            String               @map("full_name") @db.VarChar(200)
  documentType        String               @map("document_type") @db.VarChar(50)
  documentNumber      String               @map("document_number") @db.VarChar(100)
  relationshipToDonor String               @map("relationship_to_donor") @db.VarChar(100)
  signatureStorageKey String?              @map("signature_storage_key") @db.VarChar(500)
  signedAt            DateTime?            @map("signed_at") @db.Timestamptz(6)
  legalization        DonationLegalization @relation(fields: [legalizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([legalizationId])
  @@map("DONATION_REPRESENTATIVE")
}

model SourceDocument {
  id               String              @id @default(uuid()) @db.Uuid
  donorId          String              @map("donor_id") @db.Uuid
  uploadedById     String              @map("uploaded_by") @db.Uuid
  originalFilename String              @map("original_filename") @db.VarChar(255)
  mimeType         String              @map("mime_type") @db.VarChar(100)
  documentCategory String              @map("document_category") @db.VarChar(100)
  objectStorageKey String              @map("object_storage_key") @db.VarChar(500)
  sha256Hash       String              @map("sha256_hash") @db.Char(64)
  status           String              @db.VarChar(50)
  uploadedAt       DateTime            @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  processId        String?             @map("process_id") @db.Uuid
  donor            DonorRecord         @relation(fields: [donorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  process          DonationProcess?    @relation(fields: [processId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  uploadedBy       SystemUser          @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  ocrJobs          OcrProcessingJob[]
  ocrFields        OcrExtractedField[]
  fieldProvenance  DocumentFieldProvenance[]

  @@index([donorId, uploadedAt])
  @@index([processId])
  @@index([sha256Hash])
  @@unique([donorId, sha256Hash])
  @@map("SOURCE_DOCUMENT")
}

model OcrProcessingJob {
  id               String              @id @default(uuid()) @db.Uuid
  sourceDocumentId String              @map("source_document_id") @db.Uuid
  requestedById    String              @map("requested_by") @db.Uuid
  providerName     String              @map("provider_name") @db.VarChar(100)
  status           OcrJobStatus
  attemptNumber    Int                 @default(1) @map("attempt_number")
  correlationId    String              @map("correlation_id") @db.VarChar(100)
  errorCode        String?             @map("error_code") @db.VarChar(100)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  sourceDocument   SourceDocument      @relation(fields: [sourceDocumentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  requestedBy      SystemUser          @relation("OcrRequester", fields: [requestedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  extractedFields  OcrExtractedField[]

  @@unique([sourceDocumentId, correlationId])
  @@index([status, createdAt])
  @@map("OCR_PROCESSING_JOB")
}

model OcrExtractedField {
  id                String              @id @default(uuid()) @db.Uuid
  ocrJobId          String              @map("ocr_job_id") @db.Uuid
  sourceDocumentId  String              @map("source_document_id") @db.Uuid
  donorId           String              @map("donor_id") @db.Uuid
  canonicalFieldKey String              @map("canonical_field_key") @db.VarChar(150)
  candidateValue    String              @map("candidate_value") @db.Text
  confidenceScore   Decimal             @map("confidence_score") @db.Decimal(4, 3)
  boundingBox       Json?               @map("bounding_box")
  validationStatus  OcrValidationStatus @map("validation_status")
  confirmedValue    String?             @map("confirmed_value") @db.Text
  validatedById     String?             @map("validated_by") @db.Uuid
  validatedAt       DateTime?           @map("validated_at") @db.Timestamptz(6)
  ocrJob            OcrProcessingJob    @relation(fields: [ocrJobId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sourceDocument    SourceDocument      @relation(fields: [sourceDocumentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  donor             DonorRecord         @relation(fields: [donorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  validatedBy       SystemUser?         @relation("OcrValidator", fields: [validatedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  fieldProvenance   DocumentFieldProvenance[]

  @@index([donorId, canonicalFieldKey])
  @@index([validationStatus])
  @@map("OCR_EXTRACTED_FIELD")
}

model OrganRecoverySurgery {
  id                   String      @id @default(uuid()) @db.Uuid
  donorId              String      @map("donor_id") @db.Uuid
  leadSurgeonId        String      @map("lead_surgeon_id") @db.Uuid
  procedureStartedAt   DateTime?   @map("procedure_started_at") @db.Timestamptz(6)
  aorticClampAt        DateTime?   @map("aortic_clamp_at") @db.Timestamptz(6)
  procedureEndedAt     DateTime?   @map("procedure_ended_at") @db.Timestamptz(6)
  organsRecovered      Json?       @map("organs_recovered")
  preservationSolution Json?       @map("preservation_solution")
  surgicalTeam         Json?       @map("surgical_team")
  processId            String?     @map("process_id") @db.Uuid
  donor                DonorRecord @relation(fields: [donorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  process              DonationProcess? @relation(fields: [processId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  leadSurgeon          SystemUser  @relation("LeadSurgeonSurgery", fields: [leadSurgeonId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([donorId, procedureStartedAt])
  @@index([processId])
  @@map("ORGAN_RECOVERY_SURGERY")
}

model TissueRecoveryProcedure {
  id                  String         @id @default(uuid()) @db.Uuid
  donorId             String         @map("donor_id") @db.Uuid
  technicianId        String         @map("technician_id") @db.Uuid
  leadSurgeonId       String         @map("lead_surgeon_id") @db.Uuid
  tissueCategory      TissueCategory @map("tissue_category")
  checklistData       Json?          @map("checklist_data")
  recoveredComponents Json?          @map("recovered_components")
  forensicEvidence    Json?          @map("forensic_evidence")
  processId           String?        @map("process_id") @db.Uuid
  donor               DonorRecord    @relation(fields: [donorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  process             DonationProcess? @relation(fields: [processId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  technician          SystemUser     @relation("TissueTechnician", fields: [technicianId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  leadSurgeon         SystemUser     @relation("TissueSurgeon", fields: [leadSurgeonId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([donorId, tissueCategory])
  @@index([processId])
  @@map("TISSUE_RECOVERY_PROCEDURE")
}

model DocumentTemplate {
  id           String            @id @default(uuid()) @db.Uuid
  templateCode String            @unique @map("template_code") @db.VarChar(100)
  name         String            @db.VarChar(200)
  category     String            @db.VarChar(100)
  status       String            @default("ACTIVE") @db.VarChar(50)
  metadata     Json?
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  versions     TemplateVersion[]
  instances    DocumentInstance[]
  processDocuments ProcessDocument[]

  @@map("DOCUMENT_TEMPLATE")
}

model TemplateVersion {
  id             String                 @id @default(uuid()) @db.Uuid
  templateId     String                 @map("template_id") @db.Uuid
  versionNumber  String                 @map("version_number") @db.VarChar(50)
  effectiveFrom  DateTime               @map("effective_from") @db.Timestamptz(6)
  status         String                 @db.VarChar(50)
  jsonSchema     Json                   @map("json_schema")
  uiSchema       Json                   @map("ui_schema")
  mappingConfig  Json                   @map("mapping_config")
  dependencyConfig Json?                @map("dependency_config")
  generationConfig Json?                @map("generation_config")
  definitionHash String?                @map("definition_hash") @db.Char(64)
  authorizedById String                 @map("authorized_by") @db.Uuid
  createdById    String                 @map("created_by") @db.Uuid
  publishedAt    DateTime?              @map("published_at") @db.Timestamptz(6)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  template       DocumentTemplate       @relation(fields: [templateId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  authorizedBy   SystemUser             @relation("TemplateAuthorizer", fields: [authorizedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy      SystemUser             @relation("TemplateVersionCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  generatedPdfs  GeneratedPdfDocument[]
  instances      DocumentInstance[]
  processDocuments ProcessDocument[]

  @@unique([templateId, versionNumber])
  @@index([status, effectiveFrom])
  @@map("TEMPLATE_VERSION")
}

model GeneratedPdfDocument {
  id                   String          @id @default(uuid()) @db.Uuid
  donorId              String          @map("donor_id") @db.Uuid
  templateVersionId    String          @map("template_version_id") @db.Uuid
  documentCode         String          @map("document_code") @db.VarChar(100)
  objectStorageKey     String          @map("object_storage_key") @db.VarChar(500)
  sha256Hash           String          @map("sha256_hash") @db.Char(64)
  anonymizationApplied Boolean         @default(false) @map("anonymization_applied")
  dataSnapshot         Json            @map("data_snapshot")
  generatedById        String          @map("generated_by") @db.Uuid
  approvedById         String?         @map("approved_by") @db.Uuid
  documentInstanceId  String?         @map("document_instance_id") @db.Uuid
  donor                DonorRecord     @relation(fields: [donorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  templateVersion      TemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  generatedBy          SystemUser      @relation("DocumentGenerator", fields: [generatedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  approvedBy           SystemUser?     @relation("DocumentApprover", fields: [approvedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  documentInstance     DocumentInstance? @relation(fields: [documentInstanceId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([donorId])
  @@index([templateVersionId])
  @@index([documentInstanceId])
  @@map("GENERATED_PDF_DOCUMENT")
}

model DocumentInstance {
  id                String                     @id @default(uuid()) @db.Uuid
  donorId           String                     @map("donor_id") @db.Uuid
  templateId        String                     @map("template_id") @db.Uuid
  templateVersionId String                     @map("template_version_id") @db.Uuid
  documentCode      String                     @map("document_code") @db.VarChar(100)
  status            String                     @default("DRAFT") @db.VarChar(50)
  currentRevisionId String?                    @unique @map("current_revision_id") @db.Uuid
  createdById       String                     @map("created_by") @db.Uuid
  updatedById       String                     @map("updated_by") @db.Uuid
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt       DateTime?                  @map("completed_at") @db.Timestamptz(6)
  approvedAt        DateTime?                  @map("approved_at") @db.Timestamptz(6)
  processId         String?                    @map("process_id") @db.Uuid
  processDocumentId String?                    @map("process_document_id") @db.Uuid
  donor             DonorRecord                @relation(fields: [donorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  process           DonationProcess?           @relation(fields: [processId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  processDocument   ProcessDocument?           @relation("ProcessDocumentInstances", fields: [processDocumentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  template          DocumentTemplate           @relation(fields: [templateId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  templateVersion   TemplateVersion            @relation(fields: [templateVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy         SystemUser                 @relation("DocumentInstanceCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  updatedBy         SystemUser                 @relation("DocumentInstanceUpdater", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  currentRevision   DocumentResponseRevision?  @relation("CurrentDocumentRevision", fields: [currentRevisionId, id], references: [id, documentInstanceId], onDelete: Restrict, onUpdate: Cascade)
  revisions         DocumentResponseRevision[] @relation("InstanceRevisions")
  generatedPdfs     GeneratedPdfDocument[]
  currentOfProcessDocument ProcessDocument?    @relation("CurrentProcessDocumentInstance")

  @@index([donorId, status, updatedAt])
  @@index([processId])
  @@index([processDocumentId])
  @@index([templateVersionId, status])
  @@unique([currentRevisionId, id])
  @@map("DOCUMENT_INSTANCE")
}

model DocumentResponseRevision {
  id                 String                    @id @default(uuid()) @db.Uuid
  documentInstanceId String                    @map("document_instance_id") @db.Uuid
  revisionNumber     Int                       @map("revision_number")
  responseData       Json                      @map("response_data")
  validationSummary  Json?                     @map("validation_summary")
  changeSummary      Json?                     @map("change_summary")
  createdById        String                    @map("created_by") @db.Uuid
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  documentInstance   DocumentInstance           @relation("InstanceRevisions", fields: [documentInstanceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  currentOf          DocumentInstance?          @relation("CurrentDocumentRevision")
  createdBy          SystemUser                @relation("ResponseRevisionCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  provenance         DocumentFieldProvenance[]

  @@unique([documentInstanceId, revisionNumber])
  @@unique([id, documentInstanceId])
  @@index([documentInstanceId, createdAt])
  @@map("DOCUMENT_RESPONSE_REVISION")
}

model DocumentFieldProvenance {
  id                 String                   @id @default(uuid()) @db.Uuid
  responseRevisionId String                   @map("response_revision_id") @db.Uuid
  fieldPath          String                   @map("field_path") @db.VarChar(300)
  canonicalFieldKey  String?                  @map("canonical_field_key") @db.VarChar(150)
  sourceKind         String                   @map("source_kind") @db.VarChar(50)
  sourceEntityId     String?                  @map("source_entity_id") @db.Uuid
  sourceDocumentId   String?                  @map("source_document_id") @db.Uuid
  ocrFieldId         String?                  @map("ocr_field_id") @db.Uuid
  validatedById      String?                  @map("validated_by") @db.Uuid
  validatedAt        DateTime?                @map("validated_at") @db.Timestamptz(6)
  conflictStatus     String                   @default("NONE") @map("conflict_status") @db.VarChar(50)
  conflictDetails    Json?                    @map("conflict_details")
  sourceValue        Json?                   @map("source_value")
  conflictResolvedById String?              @map("conflict_resolved_by") @db.Uuid
  conflictResolvedAt DateTime?              @map("conflict_resolved_at") @db.Timestamptz(6)
  conflictDecision   String?                @map("conflict_decision") @db.VarChar(100)
  conflictJustification String?             @map("conflict_justification") @db.Text
  responseRevision   DocumentResponseRevision @relation(fields: [responseRevisionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sourceDocument     SourceDocument?          @relation(fields: [sourceDocumentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  ocrField           OcrExtractedField?       @relation(fields: [ocrFieldId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  validatedBy        SystemUser?              @relation("ProvenanceValidator", fields: [validatedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  conflictResolvedBy  SystemUser?             @relation("ConflictResolver", fields: [conflictResolvedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([responseRevisionId, fieldPath])
  @@index([canonicalFieldKey])
  @@index([sourceDocumentId])
  @@index([ocrFieldId])
  @@map("DOCUMENT_FIELD_PROVENANCE")
}

model AuditEvent {
  id            String     @id @default(uuid()) @db.Uuid
  actorUserId   String     @map("actor_user_id") @db.Uuid
  action        String     @db.VarChar(100)
  entityType    String     @map("entity_type") @db.VarChar(100)
  entityId      String     @map("entity_id") @db.Uuid
  occurredAt    DateTime   @default(now()) @map("occurred_at") @db.Timestamptz(6)
  correlationId String     @map("correlation_id") @db.VarChar(100)
  metadata      Json?
  actor         SystemUser @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([entityType, entityId])
  @@index([actorUserId, occurredAt])
  @@index([correlationId])
  @@map("AUDIT_EVENT")
}

model DonationProcess {
  id              String                 @id @default(uuid()) @db.Uuid
  processCode     String                 @unique @map("process_code") @db.VarChar(100)
  donorId         String                 @map("donor_id") @db.Uuid
  packageVersionId String?               @map("package_version_id") @db.Uuid
  status          DonationProcessStatus  @default(EN_VALORACION)
  primaryIpsName  String                 @map("primary_ips_name") @db.VarChar(200)
  openedById      String                 @map("opened_by_id") @db.Uuid
  closedById      String?                @map("closed_by_id") @db.Uuid
  openedAt        DateTime               @default(now()) @map("opened_at") @db.Timestamptz(6)
  closedAt        DateTime?              @map("closed_at") @db.Timestamptz(6)
  notes           String?                @db.Text
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  donor           DonorRecord            @relation(fields: [donorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  packageVersion  ProcessPackageVersion? @relation(fields: [packageVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  openedBy        SystemUser             @relation("ProcessOpenedBy", fields: [openedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  closedBy        SystemUser?            @relation("ProcessClosedBy", fields: [closedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  institutions    ProcessInstitution[]
  participants    ProcessParticipant[]
  documents       ProcessDocument[]
  documentInstances DocumentInstance[]
  sourceDocuments SourceDocument[]
  organSurgeries  OrganRecoverySurgery[]
  tissueProcedures TissueRecoveryProcedure[]
  canonicalValues ProcessCanonicalValue[]
  canonicalHistory ProcessCanonicalHistory[]

  @@index([status])
  @@index([donorId])
  @@index([primaryIpsName])
  @@index([packageVersionId])
  @@map("DONATION_PROCESS")
}

model ProcessInstitution {
  id              String                 @id @default(uuid()) @db.Uuid
  processId       String                 @map("process_id") @db.Uuid
  institutionName String                 @map("institution_name") @db.VarChar(200)
  role            ProcessInstitutionRole
  notes           String?                @db.Text
  assignedAt      DateTime               @default(now()) @map("assigned_at") @db.Timestamptz(6)
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  process         DonationProcess        @relation(fields: [processId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([processId, role])
  @@map("PROCESS_INSTITUTION")
}

model ProcessParticipant {
  id                  String                 @id @default(uuid()) @db.Uuid
  processId           String                 @map("process_id") @db.Uuid
  fullName            String                 @map("full_name") @db.VarChar(200)
  documentType        String?                @map("document_type") @db.VarChar(20)
  documentNumber      String?                @map("document_number") @db.VarChar(100)
  role                ProcessParticipantRole
  professionalId      String?                @map("professional_id") @db.VarChar(100)
  institution         String?                @db.VarChar(200)
  relationshipToDonor String?                @map("relationship_to_donor") @db.VarChar(100)
  phone               String?                @db.VarChar(50)
  email               String?                @db.VarChar(320)
  notes               String?                @db.Text
  systemUserId        String?                @map("system_user_id") @db.Uuid
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  process             DonationProcess        @relation(fields: [processId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  systemUser          SystemUser?            @relation("ParticipantSystemUser", fields: [systemUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([processId, role])
  @@index([documentNumber])
  @@map("PROCESS_PARTICIPANT")
}

model ProcessPackage {
  id           String                  @id @default(uuid()) @db.Uuid
  code         String                  @unique @db.VarChar(100)
  name         String                  @db.VarChar(200)
  description  String?                 @db.Text
  isActive     Boolean                 @default(true) @map("is_active")
  createdById  String                  @map("created_by_id") @db.Uuid
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy    SystemUser              @relation("PackageCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  versions     ProcessPackageVersion[]

  @@map("PROCESS_PACKAGE")
}

model ProcessPackageVersion {
  id               String            @id @default(uuid()) @db.Uuid
  packageId        String            @map("package_id") @db.Uuid
  versionNumber    String            @map("version_number") @db.VarChar(50)
  status           String            @default("DRAFT") @db.VarChar(50)
  effectiveFrom    DateTime          @default(now()) @map("effective_from") @db.Timestamptz(6)
  effectiveTo      DateTime?         @map("effective_to") @db.Timestamptz(6)
  description      String?           @db.Text
  definitionHash   String?           @map("definition_hash") @db.Char(64)
  positionsConfig  Json              @map("positions_config")
  createdById      String            @map("created_by_id") @db.Uuid
  authorizedById   String?           @map("authorized_by_id") @db.Uuid
  publishedAt      DateTime?         @map("published_at") @db.Timestamptz(6)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  package          ProcessPackage    @relation(fields: [packageId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy        SystemUser        @relation("PackageVersionCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  authorizedBy     SystemUser?       @relation("PackageVersionAuthorizer", fields: [authorizedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  donationProcesses DonationProcess[]

  @@unique([packageId, versionNumber])
  @@index([packageId, status])
  @@map("PROCESS_PACKAGE_VERSION")
}

model ProcessDocument {
  id                     String            @id @default(uuid()) @db.Uuid
  processId              String            @map("process_id") @db.Uuid
  positionNumber         Int               @map("position_number")
  documentCode           String            @map("document_code") @db.VarChar(100)
  title                  String            @db.VarChar(255)
  category               String            @db.VarChar(100)
  status                 String            @default("PENDIENTE") @db.VarChar(50)
  applicabilityStatus    String            @default("APLICABLE") @map("applicability_status") @db.VarChar(50)
  nonApplicabilityReason String?           @map("non_applicability_reason") @db.Text
  isMandatory            Boolean           @default(true) @map("is_mandatory")
  orderIndex             Int               @map("order_index")
  rules                  Json?
  templateId             String?           @map("template_id") @db.Uuid
  templateVersionId      String?           @map("template_version_id") @db.Uuid
  currentInstanceId      String?           @unique @map("current_instance_id") @db.Uuid
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  process                DonationProcess   @relation(fields: [processId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  template               DocumentTemplate? @relation(fields: [templateId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  templateVersion        TemplateVersion?  @relation(fields: [templateVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  currentInstance        DocumentInstance? @relation("CurrentProcessDocumentInstance", fields: [currentInstanceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  instances              DocumentInstance[] @relation("ProcessDocumentInstances")

  @@unique([processId, positionNumber])
  @@unique([processId, documentCode])
  @@index([processId, status])
  @@index([processId, applicabilityStatus])
  @@map("PROCESS_DOCUMENT")
}

model CanonicalFieldDefinition {
  id                String                    @id @default(uuid()) @db.Uuid
  canonicalFieldKey String                    @unique @map("canonical_field_key") @db.VarChar(150)
  displayName       String                    @map("display_name") @db.VarChar(200)
  description       String?                   @db.Text
  dataType          String                    @map("data_type") @db.VarChar(50)
  unit              String?                   @db.VarChar(50)
  scope             String                    @db.VarChar(50)
  cardinality       String                    @default("SINGLE") @db.VarChar(50)
  sharingPolicy     String                    @default("SHARED") @map("sharing_policy") @db.VarChar(50)
  allowedSources    Json                      @map("allowed_sources")
  writable          Boolean                   @default(true)
  validationRules   Json?                     @map("validation_rules")
  status            String                    @default("ACTIVE") @db.VarChar(50)
  version           Int                       @default(1)
  createdById       String?                   @map("created_by_id") @db.Uuid
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  processValues     ProcessCanonicalValue[]
  historyEntries    ProcessCanonicalHistory[]
  createdBy         SystemUser?               @relation("CanonicalFieldCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([scope, status])
  @@index([canonicalFieldKey])
  @@map("CANONICAL_FIELD_DEFINITION")
}

model ProcessCanonicalValue {
  id                String                    @id @default(uuid()) @db.Uuid
  processId         String                    @map("process_id") @db.Uuid
  canonicalFieldKey String                    @map("canonical_field_key") @db.VarChar(150)
  currentValue      Json                      @map("current_value")
  unit              String?                   @db.VarChar(50)
  effectiveAt       DateTime                  @default(now()) @map("effective_at") @db.Timestamptz(6)
  sampleContext     String?                   @map("sample_context") @db.VarChar(200)
  sourceKind        String                    @map("source_kind") @db.VarChar(50)
  sourceInstanceId  String?                   @map("source_instance_id") @db.Uuid
  sourceRevisionId  String?                   @map("source_revision_id") @db.Uuid
  versionNumber     Int                       @default(1) @map("version_number")
  conflictStatus    String                    @default("NONE") @map("conflict_status") @db.VarChar(50)
  conflictDetails   Json?                     @map("conflict_details")
  updatedById       String                    @map("updated_by_id") @db.Uuid
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  process           DonationProcess           @relation(fields: [processId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  canonicalField    CanonicalFieldDefinition  @relation(fields: [canonicalFieldKey], references: [canonicalFieldKey], onDelete: Restrict, onUpdate: Cascade)
  updatedBy         SystemUser                @relation("CanonicalValueUpdater", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([processId, canonicalFieldKey])
  @@index([processId, conflictStatus])
  @@map("PROCESS_CANONICAL_VALUE")
}

model ProcessCanonicalHistory {
  id                String                    @id @default(uuid()) @db.Uuid
  processId         String                    @map("process_id") @db.Uuid
  canonicalFieldKey String                    @map("canonical_field_key") @db.VarChar(150)
  value             Json
  unit              String?                   @db.VarChar(50)
  effectiveAt       DateTime                  @default(now()) @map("effective_at") @db.Timestamptz(6)
  sampleContext     String?                   @map("sample_context") @db.VarChar(200)
  sourceKind        String                    @map("source_kind") @db.VarChar(50)
  sourceInstanceId  String?                   @map("source_instance_id") @db.Uuid
  sourceRevisionId  String?                   @map("source_revision_id") @db.Uuid
  sourceDocumentId  String?                   @map("source_document_id") @db.Uuid
  versionNumber     Int                       @map("version_number")
  createdById       String                    @map("created_by_id") @db.Uuid
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)

  process           DonationProcess           @relation(fields: [processId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  canonicalField    CanonicalFieldDefinition  @relation(fields: [canonicalFieldKey], references: [canonicalFieldKey], onDelete: Restrict, onUpdate: Cascade)
  createdBy         SystemUser                @relation("CanonicalHistoryCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([processId, canonicalFieldKey, effectiveAt])
  @@index([processId, canonicalFieldKey, versionNumber])
  @@map("PROCESS_CANONICAL_HISTORY")
}

